{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  // Layer boundaries (ADR 0007).
  // Oxlint traps, both found by mutation experiments:
  // - a negated group ("!../**") cancels every other pattern of the rule, so core uses regex;
  // - a regex with lookahead does not compile and silently disables the pattern.
  "overrides": [
    {
      // A stray console.log of a token or a Firebase user is the most likely way a
      // credential ends up somewhere it should not.
      "files": ["src/**"],
      "rules": {
        "no-console": ["error", { "allow": ["warn", "error"] }]
      }
    },
    {
      // fake-indexeddb/auto replaces the global indexedDB with an in-memory one. In a file
      // that reaches the bundle, the app would work and lose everything, the upload queue
      // included, every time it is closed, with no error anywhere. Allowed only in
      // src/adapters/**/*.test.ts. Here for src/main.tsx and any file no later override
      // covers; a later override replaces this rule, so adapters and ui restate the ban
      // (core already forbids every package).
      "files": ["src/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["fake-indexeddb", "fake-indexeddb/**"],
              "message": "fake-indexeddb only in src/adapters/**/*.test.ts: in the bundle it would replace the real IndexedDB."
            }
          ]
        }]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              // Anything not relative, or a path through adapters, ui or main.
              "regex": "^[^.]|(^|/)(adapters|ui|main)(/|\\.|$)",
              "message": "core may import only other files in src/core/ (ADR 0007)."
            }
          ]
        }]
      }
    },
    {
      // Tests and shared test suites (*.suite.ts: registered by a *.test.ts, e.g. the
      // LocalStore contract run against the fake and against Dexie) may import vitest.
      "files": ["src/core/**/*.test.ts", "src/core/**/*.suite.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              // Same as above, except for the bare specifier "vitest", spelled out without lookahead.
              "regex": "^([^.v]|v([^i]|$)|vi([^t]|$)|vit([^e]|$)|vite([^s]|$)|vites([^t]|$)|vitest.)|(^|/)(adapters|ui|main)(/|\\.|$)",
              "message": "core tests may import only other files in src/core/ and vitest (ADR 0007)."
            }
          ]
        }]
      }
    },
    {
      // The contract test checks core against shared/bait-site-state-machine-cases.json.
      // It may import src/core, vitest and node: builtins, never adapters, ui or main.
      // Bare specifiers other than "vitest" and "node:*" spelled out without lookahead.
      "files": ["contract/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "regex": "^([^.vn]|v([^i]|$)|vi([^t]|$)|vit([^e]|$)|vite([^s]|$)|vites([^t]|$)|vitest.|n([^o]|$)|no([^d]|$)|nod([^e]|$)|node([^:]|$))|(^|/)(adapters|ui|main)(/|\\.|$)",
              "message": "the contract test may import only src/core, vitest and node: builtins (ADR 0007)."
            }
          ]
        }]
      }
    },
    {
      "files": ["src/adapters/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["**/ui", "**/ui/**"],
              "message": "adapters may not import ui. Wire them in src/main.tsx (ADR 0007)."
            },
            {
              "group": ["fake-indexeddb", "fake-indexeddb/**"],
              "message": "fake-indexeddb only in src/adapters/**/*.test.ts: in the bundle it would replace the real IndexedDB."
            }
          ]
        }]
      }
    },
    {
      // Adapter tests may import fake-indexeddb (Node has no IndexedDB). This replaces the
      // rule of the override above, so the ui ban is restated.
      "files": ["src/adapters/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["**/ui", "**/ui/**"],
              "message": "adapters may not import ui. Wire them in src/main.tsx (ADR 0007)."
            }
          ]
        }]
      }
    },
    {
      "files": ["src/ui/**"],
      "rules": {
        "no-restricted-imports": ["error", {
          "patterns": [
            {
              "group": ["**/adapters", "**/adapters/**"],
              "message": "ui may not import adapters. Wire them in src/main.tsx (ADR 0007)."
            },
            {
              // The screen depends on core's interfaces, never on the database library
              // (ADR 0007 rule 3, ADR 0008 rule 6): no useLiveQuery.
              "group": ["dexie", "dexie/**"],
              "message": "ui may not import dexie. Read through core's LocalStore port (ADR 0008)."
            },
            {
              "group": ["fake-indexeddb", "fake-indexeddb/**"],
              "message": "fake-indexeddb only in src/adapters/**/*.test.ts: in the bundle it would replace the real IndexedDB."
            }
          ]
        }]
      }
    }
  ]
}
