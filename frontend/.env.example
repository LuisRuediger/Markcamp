# Firebase web app config (Firebase console > Project settings > Your apps > Web app).
# Not a secret (ADR 0007, decision 9), but it varies per environment.
# Copy to .env.local (git-ignored) and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional. The host name `tailscale serve` gives this machine, so `npm run preview`
# can be opened from a phone in the tailnet (e.g. markcamp-dev.<tailnet>.ts.net).
# Host name only: no https://, no port, no slash. Not a secret, but machine-specific.
# Leave empty to keep vite preview on localhost only.
MARKCAMP_PREVIEW_HOST=
